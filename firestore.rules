rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== BRUKARAR =====
    match /brukarar/{uid} {
      // Alle som er logga inn kan sjå profilar
      allow read: if request.auth != null;
      // Du kan berre endre din EIGEN profil (òg kven du følgjer)
      allow write: if request.auth != null && request.auth.uid == uid;

      // E-posten ligg i ei privat mappe under brukaren. Berre du sjølv ser han.
      match /privat/{dokument} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ===== TEKSTAR =====
    match /innlegg/{id} {
      // Offentlege tekstar kan alle lese. Private tekstar berre eigaren.
      allow read: if request.auth != null
        && (resource.data.privat == false || resource.data.uid == request.auth.uid);
      // Du kan berre lage tekstar i ditt eige namn
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Eigaren kan redigere. Andre kan berre gje hjarte.
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hjarte']));
      // Berre eigaren kan slette
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // ===== SVAR UNDER EIN TEKST =====
      match /svar/{svarId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        // Andre kan berre leggje til emoji-reaksjonar
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaksjonar']);
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // ===== RAPPORTAR =====
    // Alle kan sende, men ingen kan lese dei frå nettsida.
    // Berre du som admin ser dei inne i Firebase.
    match /rapportar/{id} {
      allow create: if request.auth != null && request.resource.data.rapportertAv == request.auth.uid;
    }
  }
}
